# 이 파일은 그대로 두고 쓰면 됩니다. 복사하거나 수정할 필요가 없습니다.
# 아래 주소는 실제로 배포된 서버입니다.
# 접근 코드는 이 파일이 아니라 앱 첫 화면에 입력합니다 (제출 메일 참고).

# remote = 실제 Google OCR / mock = 네트워크 없이 화면 흐름만
EXPO_PUBLIC_OCR_MODE=remote

# 배포된 OCR 중계 서버
EXPO_PUBLIC_OCR_API_URL=https://artinus-ocr-api-544173682720.us-central1.run.app/ocr

# 카메라 없는 시뮬레이터용 샘플 이미지 버튼. 개발 빌드에서만 보입니다.
EXPO_PUBLIC_ENABLE_FIXTURE=false

# EXPO_PUBLIC_* 값은 앱 번들에 그대로 포함됩니다.
# API 키, 서비스 계정 키, 접근 코드는 여기에 넣지 마세요.
