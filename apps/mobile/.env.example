# Public build configuration only. Never put OCR credentials/access codes here.
EXPO_PUBLIC_OCR_MODE=remote
# Development builds only: enable a labelled sample image in mock or remote mode.
EXPO_PUBLIC_ENABLE_FIXTURE=false
# HTTPS OCR proxy endpoint. Remote mode requests the evaluation access code in-app.
EXPO_PUBLIC_OCR_API_URL=https://artinus-ocr-api-544173682720.us-central1.run.app/ocr
